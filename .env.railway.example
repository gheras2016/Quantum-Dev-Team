# ---------------------------------------------------------------------------
# Railway environment variables (native Nixpacks deploy — no Docker).
# Set these in: Railway → your service → Variables.
# The MySQL values come from the MySQL database service you add on Railway.
# ---------------------------------------------------------------------------

APP_NAME="Quantum Dev Team"
APP_ENV=production
APP_DEBUG=false
# Generate once with:  php artisan key:generate --show
APP_KEY=
# Your Railway public domain, e.g. https://quantum-dev-team-production.up.railway.app
APP_URL=

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Database: MySQL (from the Railway MySQL service) ------------------------
DB_CONNECTION=mysql
DB_HOST=${{ MySQL.MYSQLHOST }}
DB_PORT=${{ MySQL.MYSQLPORT }}
DB_DATABASE=${{ MySQL.MYSQLDATABASE }}
DB_USERNAME=${{ MySQL.MYSQLUSER }}
DB_PASSWORD=${{ MySQL.MYSQLPASSWORD }}
# (Replace "MySQL" with the actual name of your MySQL service if different.)

# --- Runtime ----------------------------------------------------------------
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# --- Persistent image storage (optional but recommended) --------------------
# Railway's filesystem is ephemeral, so uploads persist only via Cloudinary.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# --- Mail (configure a real SMTP provider for production email) -------------
MAIL_MAILER=log

# --- Seeded super admin (optional overrides) --------------------------------
# ADMIN_EMAIL=admin@quantum.test
# ADMIN_PASSWORD=change-me-strong

# ---------------------------------------------------------------------------
# NOTE: migrations & seeding run automatically via the Pre-Deploy command in
# railway.json:  php artisan migrate --force && php artisan db:seed --force
# ---------------------------------------------------------------------------
